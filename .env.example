# このファイルは「変数名だけ」の見本です。Git で共有されます。
# 実際の値は .env.local に書いてください（.env.local は Git に入りません）。

# --- Supabase（Step 1 で設定します）---
# 新しいキー体系（publishable / secret）を使います。
# 旧体系の anon / service_role（eyJ... で始まる JWT）は使いません。

# ブラウザに公開されてよい値。RLS が守るため公開前提の設計です。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# サーバー専用の値。RLS を無視できる強力な鍵。
# - 絶対に NEXT_PUBLIC_ を付けない
# - クライアントコンポーネントから import しない
# - 必要になる処理（Step 3 以降のサーバー関数まわり）まで、コードから参照しない
SUPABASE_SECRET_KEY=

# 共有カードの絶対URL に使う。未設定なら http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Step 16 で追加 ---

# 掃除 Cron（/api/cron/cleanup）の入口を守る合言葉。
# **未設定だと掃除は 503 で動かない。**素通しにはしない。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# 通報の CAPTCHA（Cloudflare Turnstile / P6）。
# **本番では、鍵が欠けていると通報そのものを 503 で止める。**素通しにはしない
# （src/features/report/captcha.ts と src/proxy.ts）。公開前に必ず設定する。
# 開発では、両方とも空なら検証を飛ばす。片方だけ入っていると設定ミスとして止める。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 任意。Turnstile の応答に入るホスト名の照合先を、ここで上書きできる。
# 空なら NEXT_PUBLIC_SITE_URL のホスト名を使う（ふだんは空でよい）。
TURNSTILE_EXPECTED_HOSTNAME=

# =====================================================================
# --- 公開の下ごしらえ（setup:domain / setup:auth だけが使う）---
#
# **アプリは1つも読まない。**手元で下ごしらえを走らせるときだけ要る。
# Vercel には入れないこと（アプリが使わないので、置くと漏れる面だけ増える）。
# =====================================================================

# 本番のドメイン。https:// も末尾スラッシュも付けない
SITE_DOMAIN=
# 畳む旧URL（D115）。指定すると verify:launch がリダイレクトを確かめる
OLD_DOMAIN=
# プライバシーポリシーに載せる contact@ の転送先（自分がふだん読むアドレス）
CONTACT_FORWARD_TO=

# Cloudflare
# トークンに要る権限: Zone DNS 編集 / Email Routing / Turnstile Sites Write
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Vercel
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# 個人アカウントなら空のままでよい
VERCEL_TEAM_ID=
# Vercel の Domains 画面が別の A レコードを出したときだけ書く
VERCEL_A_RECORD=

# Supabase Management API（プロジェクトの設定を全部変えられる。取り扱い注意）
SUPABASE_ACCESS_TOKEN=
# 既定は oyyiutiptsffckujqkvl。変えるときだけ書く
SUPABASE_PROJECT_REF=

# メール送信（Resend）。SMTP のパスワードとして使う
RESEND_API_KEY=
SMTP_SENDER_EMAIL=

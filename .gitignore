# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# 実際の値が入るファイルは追跡しない
.env*
# 変数名だけの雛形は共有したいので、例外として追跡する
!.env.example

# 秘密鍵・証明書のたぐいは、置き場所を問わず追跡しない（保険）
*.pem
*.key
*.p8
*.p12
*.mobileprovision
**/service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# スモークの固定利用者（Cookie と合言葉。Git へは入れない）
.smoke-fixtures.json

# setup:auth が控える変更前の設定（外部サービスの設定が入る。Git へは入れない）
/backup
